# Copy to .env for local dev. In GitHub: Repo Settings > Secrets > Actions.
# Contact form recipient (used by contact page via FormSubmit AJAX).
PUBLIC_CONTACT_EMAIL=
# Public site URL (used for canonical / OG tags). e.g. https://tingtom.github.io/jhpaintworx/
PUBLIC_SITE_URL=https://tingtom.github.io/jhpaintworx/
