---
interface Props { title: string; description?: string; }
const { title, description = 'JH Paintworx – showroom paintwork for cars, bikes, commercials, plant & classics. Colour matching, panel repair, full resprays.' } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en-GB">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title} | JH Paintworx</title>
<meta name="description" content={description} />
<link rel="icon" href={`${base}favicon.svg`} />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700;800;900&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
<style>
:root{--navy:#0f2440;--navy2:#1a3556;--red:#c1272d;--red2:#a11f25;--cream:#f6eac5;--ink:#101c2c;--mut:#5b6b80;--line:#e8edf3;--card:#fff}
*{box-sizing:border-box}html{scroll-behavior:smooth;overflow-x:hidden}
body{margin:0;font-family:Inter,system-ui,sans-serif;color:var(--ink);background:#f7f8fa;-webkit-font-smoothing:antialiased;overflow-x:hidden}
img{max-width:100%;display:block}
h1,h2,h3{font-family:Archivo,sans-serif;letter-spacing:-.02em;line-height:1.05;margin:0}
a{color:inherit}
.topbar{background:var(--red);color:#fff;font-size:13px;font-weight:600;white-space:nowrap}
.topbar .wrap{display:flex;gap:16px;justify-content:space-between;padding:7px 16px;align-items:center}
.topbar .wrap a{color:#fff;text-decoration:none;font-weight:700}
@media(max-width:600px){.topbar .wrap{flex-direction:column;gap:2px;padding:6px 16px;text-align:center;font-size:11px}.hero-inner{padding:80px 20px 120px}.hero-cap{display:none}}
.wrap{max-width:1180px;margin:0 auto;padding:0 20px}
header.site{position:sticky;top:0;z-index:50;background:rgba(15,36,64,.92);backdrop-filter:blur(10px);color:#fff;border-bottom:1px solid rgba(255,255,255,.1)}
.nav{display:flex;align-items:center;gap:14px;padding:12px 20px;max-width:1180px;margin:0 auto}
.brand{display:flex;align-items:center;gap:12px;text-decoration:none}
.brand img{height:52px;width:auto;max-width:190px;object-fit:contain;display:block}
.brand b{font-family:Archivo;font-size:19px;letter-spacing:.04em}
.brand small{display:block;font-size:11px;letter-spacing:.28em;color:var(--cream);font-weight:700}
.links{margin-left:auto;display:flex;gap:4px;align-items:center}
.links a{text-decoration:none;font-weight:600;font-size:14px;padding:9px 13px;border-radius:9px;opacity:.92}
.links a:hover{background:rgba(255,255,255,.12);opacity:1}
.links a.cta{background:var(--red);color:#fff}
.links a.cta:hover{background:var(--red2)}
.burger{display:none;margin-left:auto;background:none;border:1px solid rgba(255,255,255,.3);color:#fff;border-radius:8px;padding:8px 10px;font-size:18px}

.btn{display:inline-flex;align-items:center;gap:8px;background:var(--red);color:#fff;padding:14px 22px;border-radius:12px;text-decoration:none;font-weight:800;font-size:15px;box-shadow:0 10px 24px rgba(193,39,45,.35);border:0;cursor:pointer}
.btn:hover{background:var(--red2);transform:translateY(-1px)}
.btn:focus-visible{outline:3px solid var(--cream);outline-offset:2px}
.btn.ghost{background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.35);box-shadow:none}

.strip{background:var(--cream);border-block:3px solid var(--navy);overflow:hidden;white-space:nowrap}
.strip div{display:inline-block;padding:10px 0;font-weight:900;letter-spacing:.22em;font-size:13px;color:var(--navy);animation:slide 22s linear infinite}
@keyframes slide{to{transform:translateX(-50%)}}
section.block{padding-block:56px}
.section-head{max-width:1180px;margin:0 auto;padding:0 20px}
.section-head p.kicker{font-weight:800;letter-spacing:.2em;font-size:12px;color:var(--red);margin:0 0 8px}
.section-head h2{font-size:clamp(26px,4vw,40px);line-height:1.05}
.section-head p.sub{color:var(--mut);max-width:60ch;margin-top:8px}
.split{display:grid;grid-template-columns:1.15fr 1fr;gap:28px;margin-top:24px;align-items:start}
.split>div{min-width:0}.split p{line-height:1.7}.split img.frame{width:100%;border-radius:18px;object-fit:cover;aspect-ratio:4/3;display:block}
.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:22px}
.scard{background:var(--card);border:1px solid var(--line);border-radius:18px;padding:22px;box-shadow:0 6px 20px rgba(16,28,44,.06);transition:.2s}
.scard:hover{transform:translateY(-4px);box-shadow:0 16px 34px rgba(16,28,44,.12)}
.scard .ic{width:46px;height:46px;border-radius:12px;display:grid;place-items:center;background:var(--navy);color:var(--cream);font-size:22px;margin-bottom:12px}
.scard h3{font-size:18px;margin-bottom:8px}.scard p{color:var(--mut);font-size:14px;line-height:1.6;margin:0}
.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:22px}
.job{background:#fff;border:1px solid var(--line);border-radius:18px;overflow:hidden;transition:.2s}
.job:hover{transform:translateY(-4px);box-shadow:0 18px 40px rgba(16,28,44,.14)}
.job .im{position:relative;aspect-ratio:4/3;overflow:hidden;background:#dde3ea}
.job img{width:100%;height:100%;object-fit:cover;display:block;transition:.5s}
.job:hover img{transform:scale(1.06)}
.job .cat{position:absolute;top:12px;left:12px;background:rgba(15,36,64,.9);color:var(--cream);font-size:11px;font-weight:800;letter-spacing:.14em;padding:6px 10px;border-radius:999px;text-transform:uppercase}
.job .p{padding:16px}.job h3{font-size:17px;margin-bottom:6px}.job p{color:var(--mut);font-size:13.5px;line-height:1.55;margin:0}
.grid,.cards{min-width:0}
.job,.scard{min-width:0;overflow:hidden}
.pills{display:flex;gap:8px;flex-wrap:nowrap;overflow-x:auto;padding-bottom:6px;margin-top:16px;-webkit-overflow-scrolling:touch;scrollbar-width:none}
.pills::-webkit-scrollbar{display:none}
.pills a{flex:0 0 auto;text-decoration:none;font-weight:800;font-size:13px;letter-spacing:.02em;padding:9px 14px;border-radius:999px;background:#fff;border:1px solid var(--line);color:var(--navy);white-space:nowrap}
.pills a.on{background:var(--navy);color:#fff;border-color:var(--navy)}
.pills a small{font-weight:600;opacity:.7}
.cta-band{background:linear-gradient(120deg,var(--red),#7e1a1f);color:#fff;border-radius:22px;padding:36px;display:flex;gap:20px;align-items:center;justify-content:space-between;flex-wrap:wrap;margin:20px 0}
section.block[style*="background"] .cta-band{margin:20px}
.cta-band h2{font-size:clamp(24px,3.5vw,36px)}.cta-band p{opacity:.9}
.btn.light{background:#fff;color:var(--red)}
.steps{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-top:20px}
.step{background:#0f2440;color:#e6edf5;border-radius:16px;padding:20px}
.step b{color:var(--cream);font-size:13px;letter-spacing:.2em}.step h3{margin:8px 0;font-size:16px}.step p{font-size:13px;color:#b9c6d8;line-height:1.6}
footer{background:#0b1a30;color:#aebdd1;margin-top:40px}
footer .cols{display:grid;grid-template-columns:1.4fr 1fr 1fr;gap:24px;padding:40px 20px;max-width:1180px;margin:0 auto}
footer h4{color:#fff;margin:0 0 10px;font-size:14px;letter-spacing:.12em}
footer a{color:#d6e0ec;text-decoration:none;font-size:14px}footer a:hover{color:var(--cream)}
.copy{border-top:1px solid rgba(255,255,255,.12);padding:14px 20px;text-align:center;font-size:13px}
form.card{background:#fff;border:1px solid var(--line);border-radius:18px;padding:24px;max-width:640px}
form.card label{font-weight:600;font-size:14px;display:block;margin-top:10px}
form.card input,form.card textarea,form.card select{width:100%;padding:12px;border:1px solid #cbd5e1;border-radius:10px;margin-top:6px;font-size:15px;transition:border-color .15s,box-shadow .15s}
form.card input:focus,form.card textarea:focus,form.card select:focus{outline:none;border-color:var(--navy);box-shadow:0 0 0 3px rgba(15,36,64,.15)}
@media(max-width:900px){.cards,.grid{grid-template-columns:repeat(2,1fr)}.steps{grid-template-columns:repeat(2,1fr)}footer .cols{grid-template-columns:1fr}.links{display:none}.links.open{display:flex;position:absolute;top:100%;left:0;right:0;background:var(--navy);flex-direction:column;padding:12px;z-index:60;box-shadow:0 10px 30px rgba(0,0,0,.3)}.burger{display:block}}
@media(max-width:800px){.split{grid-template-columns:1fr}}
@media(max-width:600px){.cards,.grid{grid-template-columns:1fr}}
</style>
</head>
<body>
<div class="topbar"><div class="wrap"><span>📞 01933 422290</span><span>🕢 Mon–Fri 07:30–17:30 · Sat by appointment</span></div></div>
<header class="site"><div class="nav">
<a class="brand" href={`${base}`}><img src={`${base}logo.png`} onerror={`this.onerror=null;this.src='${base}logo.svg'`} alt="JH Paintworx logo" /><span><b>JH PAINTWORX</b><small>SPRAY · REPAIR · REFINISH</small></span></a>
<button class="burger" onclick="document.querySelector('.links').classList.toggle('open')">☰</button>
<nav class="links">
<a href={`${base}`}>Home</a>
<a href={`${base}gallery/`}>Paint Work</a>
<a href={`${base}services/`}>Services</a>
<a href={`${base}about/`}>About</a>
<a href={`${base}contact/`} class="cta">Get a quote</a>
</nav>
</div></header>
<slot />
<footer>
<div class="cols">
<div><h4>JH PAINTWORX LTD</h4><p style="font-size:14px;line-height:1.7">Showroom paintwork, panel repair and custom refinishing for cars, bikes, vans, commercials, plant and classics.</p><p>📞 01933 422290<br />🕢 07:30–17:30</p></div>
<div><h4>EXPLORE</h4><p><a href={`${base}gallery/`}>Gallery</a><br /><a href={`${base}gallery/car/`}>Cars</a> · <a href={`${base}gallery/bike/`}>Bikes</a> · <a href={`${base}gallery/commercial/`}>Commercial</a><br /><a href={`${base}services/`}>Services</a><br /><a href={`${base}contact/`}>Contact</a></p></div>
<div><h4>WORKSHOP</h4><p><a href={`${base}about/`}>About us</a><br /><a href={`${base}admin/`}>Staff login (CMS)</a></p></div>
</div>
<div class="copy">© {new Date().getFullYear()} JH Paintworx Ltd · 01933 422290 · 07:30–17:30</div>
</footer>
</body>
</html>
