---
import { Phone, Clock, Menu, MapPin } from 'lucide-astro';
import { getCollection } from 'astro:content';
import SocialLinks from '../components/SocialLinks.astro';
interface Props { title: string; description?: string; }
const { title, description = 'JH Paintworx – showroom paintwork for cars, bikes, commercials, plant & classics. Colour matching, panel repair, full resprays.' } = Astro.props;
const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname;
const isActive = (href: string) => href === `${base}` ? path === href || path === `${base}index.html` : path.startsWith(href);
const navCls = (href: string) => `nav-link${isActive(href) ? ' active' : ''}`;
const settings = (await getCollection('settings'))[0]?.data;
const phone = settings?.phone || '01933 422290';
const tel = `tel:${phone.replace(/[^\+\d]/g, '')}`;
const hours = settings?.hours || 'Mon–Fri 07:30–17:30';
const cats = (await getCollection('categories')).sort((a, b) => a.data.order - b.data.order);
---
<!doctype html>
<html lang="en-GB">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title} | JH Paintworx</title>
<meta name="description" content={description} />
<link rel="icon" type="image/png" href={`${base}favicon.png`} />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700;800;900&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
<style is:global>
:root{--navy:#0f2440;--navy2:#1a3556;--red:#c1272d;--red2:#a11f25;--cream:#f6eac5;--ink:#101c2c;--mut:#5b6b80;--line:#e8edf3;--card:#fff;--hdr:108px}
*{box-sizing:border-box}html{scroll-behavior:smooth;overflow-x:hidden}
body{margin:0;font-family:Inter,system-ui,sans-serif;color:var(--ink);background:#f7f8fa;-webkit-font-smoothing:antialiased;overflow-x:hidden;font-size:16px;line-height:1.6}
p{line-height:1.7;margin:0 0 1em}
img{max-width:100%;display:block}
h1,h2,h3{font-family:Archivo,sans-serif;letter-spacing:-.02em;line-height:1.1;margin:0}
a{color:inherit;text-decoration:none;transition:color .15s}
section.block p a:not(.btn){color:var(--navy);font-weight:600;text-decoration:underline;text-decoration-color:rgba(15,36,64,.3);text-underline-offset:3px}
section.block p a:not(.btn):hover{color:var(--red);text-decoration-color:var(--red)}
ul,ol{line-height:1.8;margin:0 0 1em;padding-left:1.4em}
li{margin-bottom:.4em}
.topbar{background:var(--red);color:#fff;font-size:13px;font-weight:600;white-space:nowrap}
.topbar .wrap{display:flex;gap:40px;justify-content:center;position:relative;padding:7px 16px;align-items:center;font-size:12.5px}
.topbar .wrap a{color:#fff;text-decoration:none;font-weight:700}
.topbar .wrap a:hover{text-decoration:underline}
.topbar .social{position:absolute;left:16px;display:flex;gap:8px;align-items:center}
.topbar .social a{display:grid;place-items:center;width:24px;height:24px;border-radius:50%;background:rgba(255,255,255,.16);transition:.15s}
.topbar .social a:hover{background:#fff;color:var(--red);text-decoration:none}
.topbar .social svg{display:block;width:13px;height:13px}
.topbar .hours svg{margin-right:4px;vertical-align:-2px}
.topbar .tbcontact{display:inline-flex;align-items:center;gap:32px}
.topbar .tbcontact svg{margin-right:3px}
svg.lucide{display:inline-block;vertical-align:middle}
.burger svg{display:block}
@media(max-width:600px){:root{--hdr:96px}.topbar .wrap{gap:8px;justify-content:space-between;padding:6px 10px;font-size:10.5px}.topbar .tbcontact{gap:8px}.topbar .social{position:static;gap:6px}.topbar .social a{width:21px;height:21px}.topbar .wrap .hours span{display:none}.brand img{height:44px}.hero-inner{padding:80px 20px 120px}.hero-cap{display:none}}
.wrap{max-width:1180px;margin:0 auto;padding:0 20px}
header.site{position:sticky;top:0;z-index:50;background:rgba(15,36,64,.92);backdrop-filter:blur(10px);color:#fff;border-bottom:1px solid rgba(255,255,255,.1)}
.nav{display:flex;align-items:center;gap:14px;padding:12px 20px;max-width:1180px;margin:0 auto}
.brand{display:flex;align-items:center;gap:12px;text-decoration:none}
.brand img{height:52px;width:auto;max-width:190px;object-fit:contain;display:block}
.brand b{font-family:Archivo;font-size:19px;letter-spacing:.04em}
.brand small{display:block;font-size:11px;letter-spacing:.14em;color:var(--cream);font-weight:700;text-transform:capitalize}
.links{margin-left:auto;display:flex;gap:4px;align-items:center}
.links a{text-decoration:none;font-weight:600;font-size:14px;padding:9px 13px;border-radius:9px;opacity:.92}
.links a:hover{background:rgba(255,255,255,.12);opacity:1}
.links a.active{background:rgba(255,255,255,.16);opacity:1;box-shadow:inset 0 -2px 0 var(--red)}
.links a.cta.active{background:var(--red);box-shadow:inset 0 -2px 0 var(--cream)}
.links a.cta{background:var(--red);color:#fff}
.links a.cta:hover{background:var(--red2)}
.burger{display:none;margin-left:auto;background:none;border:1px solid rgba(255,255,255,.3);color:#fff;border-radius:8px;padding:8px 10px;font-size:18px}

.btn{display:inline-flex;align-items:center;gap:8px;background:var(--red);color:#fff;padding:14px 22px;border-radius:12px;text-decoration:none;font-weight:800;font-size:15px;box-shadow:0 10px 24px rgba(193,39,45,.35);border:0;cursor:pointer}
.btn:hover{background:var(--red2)}
.btn:focus-visible{outline:3px solid var(--cream);outline-offset:2px}
.btn.ghost{background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.35);box-shadow:none}
.btn.ghost.dark{color:var(--navy);border-color:var(--navy);background:transparent}
.btn.ghost.dark:hover{background:var(--navy);color:#fff;border-color:var(--navy)}
.btn.ghost.dark:focus-visible{outline-color:var(--navy)}

.strip{background:var(--cream);border-block:3px solid var(--navy);overflow:hidden;white-space:nowrap}
.strip div{display:inline-block;padding:10px 0;font-weight:900;letter-spacing:.22em;font-size:13px;color:var(--navy);animation:slide 22s linear infinite}
@keyframes slide{to{transform:translateX(-50%)}}
section.block{padding-block:40px}
.section-head{max-width:1180px;margin:0 auto;padding:0 20px}
.section-head h1{font-size:clamp(30px,5vw,48px);line-height:1.05;margin-top:4px}
.section-head p.kicker{font-weight:800;letter-spacing:.2em;font-size:12px;color:var(--red);margin:0 0 10px}
.section-head h2{font-size:clamp(26px,4vw,40px);line-height:1.08}
.section-head p.sub{color:var(--mut);max-width:60ch;margin-top:12px;font-size:16.5px}
.split{display:grid;grid-template-columns:1.15fr 1fr;gap:32px;margin-top:28px;align-items:start}
.split>div{min-width:0}
.split p{line-height:1.75;font-size:16px}
.split p.lead{font-size:17.5px;line-height:1.7;color:var(--ink);font-weight:500}
.split p.mut{color:var(--mut)}
.split img.frame{width:100%;border-radius:18px;object-fit:cover;aspect-ratio:4/3;display:block;box-shadow:0 12px 32px rgba(16,28,44,.12)}
.split ul{list-style:none;padding-left:0;margin:1.2em 0}
.split ul li{display:flex;align-items:center;gap:9px;color:var(--ink)}
.split ul li svg{color:var(--red);flex:0 0 auto}
footer a svg,footer p svg{vertical-align:-2px;margin-right:4px}
.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:22px}
.scard{background:var(--card);border:1px solid var(--line);border-radius:18px;padding:22px;box-shadow:0 6px 20px rgba(16,28,44,.06);transition:.2s}
.scard:hover{transform:translateY(-4px);box-shadow:0 16px 34px rgba(16,28,44,.12)}
.scard .ic{width:46px;height:46px;border-radius:12px;display:grid;place-items:center;background:var(--navy);color:var(--cream);font-size:22px;margin-bottom:12px}
.scard h3{font-size:18px;margin-bottom:10px;line-height:1.3}.scard p{color:var(--mut);font-size:14.5px;line-height:1.65;margin:0}
.scard a{color:var(--navy);font-weight:700;text-decoration:none;border-bottom:1px solid var(--cream)}
.scard a:hover{color:var(--red);border-bottom-color:var(--red)}
.scard h3 svg{color:var(--red);vertical-align:-3px;margin-right:6px}
.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:22px}
.job{background:#fff;border:1px solid var(--line);border-radius:18px;overflow:hidden;transition:.2s}
.job:hover{transform:translateY(-4px);box-shadow:0 18px 40px rgba(16,28,44,.14)}
.job .im{position:relative;aspect-ratio:4/3;overflow:hidden;background:#dde3ea}
.job img{width:100%;height:100%;object-fit:cover;display:block;transition:.5s}
.job:hover img{transform:scale(1.06)}
.job .cat{position:absolute;top:12px;left:12px;background:rgba(15,36,64,.9);color:var(--cream);font-size:11px;font-weight:800;letter-spacing:.14em;padding:6px 10px;border-radius:999px;text-transform:uppercase}
.job .p{padding:16px}.job h3{font-size:17px;margin-bottom:6px}.job p{color:var(--mut);font-size:13.5px;line-height:1.55;margin:0}
.grid,.cards{min-width:0}
.job,.scard{min-width:0;overflow:hidden}
.pills{display:flex;gap:8px;flex-wrap:nowrap;overflow-x:auto;padding-bottom:6px;margin-top:16px;-webkit-overflow-scrolling:touch;scrollbar-width:none}
.pills::-webkit-scrollbar{display:none}
.pills a{flex:0 0 auto;text-decoration:none;font-weight:800;font-size:13px;letter-spacing:.02em;padding:9px 14px;border-radius:999px;background:#fff;border:1px solid var(--line);color:var(--navy);white-space:nowrap}
.pills a.on{background:var(--navy);color:#fff;border-color:var(--navy)}
.pills a small{font-weight:600;opacity:.7}
.cta-band{background:linear-gradient(120deg,var(--red),#7e1a1f);color:#fff;border-radius:22px;padding:36px;display:flex;gap:20px;align-items:center;justify-content:space-between;flex-wrap:wrap;margin:20px 0}
.cta-band.center{flex-direction:column;justify-content:center;text-align:center;gap:10px;margin-inline:auto}
.cta-band.center .btn{margin-top:6px}
section.block[style*="background"] .cta-band{margin:20px}
.cta-band h2{font-size:clamp(24px,3.5vw,36px)}.cta-band p{opacity:.9}
.btn.light{background:#fff;color:var(--red)}
.steps{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-top:20px}
.step{background:#0f2440;color:#e6edf5;border-radius:16px;padding:20px}
.step b{color:var(--cream);font-size:13px;letter-spacing:.2em}.step h3{margin:8px 0;font-size:16px}.step p{font-size:13px;color:#b9c6d8;line-height:1.6}
footer{background:#0b1a30;color:#aebdd1;margin-top:40px}
footer .cols{display:grid;grid-template-columns:1.2fr 1fr;gap:24px;padding:44px 20px 36px;max-width:1180px;margin:0 auto}
footer h4{color:#fff;margin:0 0 14px;font-size:13px;letter-spacing:.14em;font-weight:800}
footer h4 .copy{font-size:11px;font-weight:600;color:#8fa3bb;letter-spacing:0;margin-left:8px}
footer .fsocial{display:flex;flex-wrap:nowrap;align-items:center;gap:10px;margin:14px 0 0}
footer .addr{white-space:pre-line}
footer .fsocial a{display:grid;place-items:center;flex:0 0 auto;width:36px;height:36px;border-radius:50%;border:1px solid rgba(255,255,255,.25);color:#d6e0ec;transition:.15s}
footer .fsocial a:hover{background:var(--red);border-color:var(--red);color:#fff}
footer .fsocial svg{display:block;width:17px;height:17px;margin:0}
footer p{line-height:1.9;margin:0 0 .8em}
footer a{color:#d6e0ec;text-decoration:none;font-size:14px;border-bottom:1px solid transparent;transition:border-color .15s,color .15s}
footer a:hover{color:var(--cream);border-bottom-color:var(--cream)}
footer a.tel{font-weight:700;font-size:17px;color:#fff;letter-spacing:.02em}
footer a.tel:hover{color:var(--cream)}
form.card{background:#fff;border:1px solid var(--line);border-radius:18px;padding:28px;max-width:640px;box-shadow:0 8px 28px rgba(16,28,44,.07)}
form.card label{font-weight:600;font-size:14px;display:block;margin-top:16px;color:var(--ink)}
form.card label:first-child{margin-top:0}
form.card input,form.card textarea,form.card select{width:100%;padding:12px 14px;border:1px solid #cbd5e1;border-radius:10px;margin-top:7px;font-size:15px;font-family:inherit;transition:border-color .15s,box-shadow .15s}
form.card input:focus,form.card textarea:focus,form.card select:focus{outline:none;border-color:var(--navy);box-shadow:0 0 0 3px rgba(15,36,64,.15)}
form.card button{margin-top:18px}
#status{margin-top:12px;font-size:14px;font-weight:600}
@media(max-width:900px){.cards,.grid{grid-template-columns:repeat(2,1fr)}.steps{grid-template-columns:repeat(2,1fr)}footer .cols{grid-template-columns:1fr}.links{display:none}.links.open{display:flex;position:absolute;top:100%;left:0;right:0;background:var(--navy);flex-direction:column;padding:12px;z-index:60;box-shadow:0 10px 30px rgba(0,0,0,.3)}.burger{display:block}}
@media(max-width:800px){.split{grid-template-columns:1fr}}
@media(max-width:600px){.cards,.grid{grid-template-columns:1fr}}
</style>
</head>
<body>
<div class="topbar"><div class="wrap">
  <SocialLinks class="social" />
  <span class="tbcontact"><a class="tel" href={tel}><Phone size={14} /> {phone}</a><span class="hours"><Clock size={14} /> {hours} <span>· Sat by appointment</span></span></span>
</div></div>
<header class="site"><div class="nav">
<a class="brand" href={`${base}`}><img src={`${base}logo.png`} alt="JH Paintworx logo" width="984" height="659" /><span><b>JH PAINTWORX</b><small>Passion for paint</small></span></a>
<button class="burger" aria-label="Menu" onclick="document.querySelector('.links').classList.toggle('open')"><Menu size={22} /></button>
<nav class="links">
<a href={`${base}`} class={navCls(`${base}`)}>Home</a>
<a href={`${base}workshop/`} class={navCls(`${base}workshop/`)}>Workshop</a>
<a href={`${base}services/`} class={navCls(`${base}services/`)}>Services</a>
<a href={`${base}about/`} class={navCls(`${base}about/`)}>Meet the team</a>
<a href={`${base}contact/`} class={`cta${isActive(`${base}contact/`) ? ' active' : ''}`}>Get a quote</a>
</nav>
</div></header>
<script is:inline>
  const setHdr = () => {
    const tb = document.querySelector('.topbar'), hd = document.querySelector('header.site');
    if (tb && hd) document.documentElement.style.setProperty('--hdr', (tb.offsetHeight + hd.offsetHeight) + 'px');
  };
  setHdr(); addEventListener('resize', setHdr);
</script>
<slot />
<footer>
<div class="cols">
<div><h4>JH PAINTWORX LTD <span class="copy">© {new Date().getFullYear()}</span></h4><p>Showroom paintwork, panel repair and custom refinishing for cars, bikes, vans, commercials, plant and classics.</p><p><a class="tel" href={tel}><Phone size={15} /> {phone}</a> &middot; <Clock size={15} /> {hours} <span>· Sat by appointment</span><br /><MapPin size={15} /> {settings.address}</p>
  <SocialLinks class="fsocial" />
</div>
<div><h4>EXPLORE</h4><p>{cats.map((c, i) => (<Fragment><a href={`${base}workshop/${c.slug}/`}>{c.data.label}</a>{i < cats.length - 1 ? ' · ' : ''}</Fragment>))}<br /><a href={`${base}services/`}>Services</a><br /><a href={`${base}about/`}>Meet the team</a><br /><a href={`${base}contact/`}>Contact</a> · <a href={`${base}contact/`}>Get a quote</a></p></div>
</div>
</footer>
</body>
</html>
