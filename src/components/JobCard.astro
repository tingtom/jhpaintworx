---
// Job card used on the workshop pages. Shows every image from the job with
// left/right arrows — manual browsing only, no auto-advance.
import { ChevronLeft, ChevronRight } from 'lucide-astro';
interface Props { job: any; label?: string; }
const { job, label } = Astro.props;
const imgs: string[] = job.data.images?.length
  ? job.data.images
  : job.data.image ? [job.data.image] : [];
---
<article class="job">
  <div class="im">
    {imgs.map((src, i) => (
      <img class:list={['slide', { on: i === 0 }]} data-i={i} src={i === 0 ? src : undefined} data-src={i === 0 ? undefined : src} alt={job.data.title} loading="lazy" />
    ))}
    {imgs.length > 1 && (
      <>
        <button class="jarrow prev" type="button" aria-label="Previous image"><ChevronLeft size={24} strokeWidth={2.5} /></button>
        <button class="jarrow next" type="button" aria-label="Next image"><ChevronRight size={24} strokeWidth={2.5} /></button>
        <span class="jcount"><b>1</b>/{imgs.length}</span>
      </>
    )}
    <span class="cat">{label ?? job.data.category}</span>
  </div>
  <div class="p"><h3>{job.data.title}</h3><p>{job.data.description ?? ''}</p></div>
</article>
<style>
.job .im{cursor:zoom-in}
.job .im .slide{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0;transition:opacity .35s ease}
.job .im .slide.on{opacity:1}
.jarrow{position:absolute;top:50%;transform:translateY(-50%);z-index:3;width:42px;height:42px;padding:0;border-radius:50%;border:1px solid rgba(255,255,255,.5);background:rgba(11,22,38,.5);color:#fff;cursor:pointer;display:grid;place-items:center;transition:.2s;backdrop-filter:blur(4px)}
</style>
<style is:global>
  /* Click-to-expand lightbox, shared by every job card on the page. */
  .lightbox{position:fixed;inset:0;z-index:1000;display:none;align-items:center;justify-content:center;background:rgba(8,14,24,.93)}
  .lightbox.on{display:flex}
  .lightbox img{max-width:92vw;max-height:88vh;object-fit:contain;box-shadow:0 20px 60px rgba(0,0,0,.5)}
  .lightbox button{position:absolute;width:60px;height:60px;padding:0;border-radius:50%;border:1px solid rgba(255,255,255,.55);background:rgba(11,22,38,.55);color:#fff;cursor:pointer;display:grid;place-items:center;font-size:34px;line-height:1;transition:.2s;backdrop-filter:blur(4px)}
  .lightbox button:hover{background:var(--red,#c1272d);border-color:var(--red,#c1272d)}
  .lb-x{top:20px;right:20px}
  .lb-p{left:16px;top:50%;transform:translateY(-50%)}
  .lb-n{right:16px;top:50%;transform:translateY(-50%)}
  .lb-c{position:absolute;bottom:20px;left:50%;transform:translateX(-50%);font-size:12px;font-weight:700;color:#fff;background:rgba(11,22,38,.55);border-radius:999px;padding:4px 10px;letter-spacing:.04em}
  @media(max-width:600px){.lb-p{left:8px}.lb-n{right:8px}.lightbox button{width:48px;height:48px;font-size:28px}}
</style>
<style>
.jarrow:hover{background:var(--red);border-color:var(--red)}
.jarrow svg{display:block}
.jarrow.prev{left:8px}.jarrow.next{right:8px}
.jcount{position:absolute;right:8px;bottom:8px;z-index:3;font-size:11px;font-weight:700;color:#fff;background:rgba(11,22,38,.55);border-radius:999px;padding:3px 8px;letter-spacing:.04em}
.jcount b{color:var(--cream)}
@media(max-width:600px){.jarrow{width:36px;height:36px}.jarrow svg{width:21px;height:21px}}
</style>
<script>
  const lb = document.createElement('div');
  lb.className = 'lightbox';
  lb.setAttribute('role', 'dialog');
  lb.setAttribute('aria-modal', 'true');
  lb.innerHTML =
    '<button class="lb-x" type="button" aria-label="Close">&times;</button>' +
    '<button class="lb-p" type="button" aria-label="Previous image">&#x2039;</button>' +
    '<button class="lb-n" type="button" aria-label="Next image">&#x203a;</button>' +
    '<img alt="" /><span class="lb-c"></span>';
  document.body.appendChild(lb);

  const lbImg: HTMLImageElement = lb.querySelector('img')!;
  const lbCount: HTMLElement = lb.querySelector('.lb-c')!;
  let lbList: string[] = [];
  let lbIndex = 0;
  const lbShow = (n: number) => {
    lbIndex = (n + lbList.length) % lbList.length;
    lbImg.src = lbList[lbIndex];
    lbCount.textContent = `${lbIndex + 1}/${lbList.length}`;
  };
  const lbOpen = (srcs: string[], start: number) => {
    lbList = srcs;
    lbShow(start);
    document.body.style.overflow = 'hidden';
    lb.classList.add('on');
  };
  const lbClose = () => {
    lb.classList.remove('on');
    document.body.style.overflow = '';
  };
  lb.querySelector('.lb-x')?.addEventListener('click', lbClose);
  lb.querySelector('.lb-p')?.addEventListener('click', () => lbShow(lbIndex - 1));
  lb.querySelector('.lb-n')?.addEventListener('click', () => lbShow(lbIndex + 1));
  lb.addEventListener('click', (e) => { if (e.target === lb) lbClose(); });
  document.addEventListener('keydown', (e) => {
    if (!lb.classList.contains('on')) return;
    if (e.key === 'Escape') lbClose();
    else if (e.key === 'ArrowLeft') lbShow(lbIndex - 1);
    else if (e.key === 'ArrowRight') lbShow(lbIndex + 1);
  });

  document.querySelectorAll('.job .im').forEach((im) => {
    const slides = Array.from(im.querySelectorAll('.slide'));
    if (!slides.length) return;
    const count = im.querySelector('.jcount b');
    let i = 0;
    if (slides.length > 1) {
      const show = (n: number) => {
        i = (n + slides.length) % slides.length;
        // Each image only downloads the first time it is shown (data-src deferral).
        const img = slides[i] as HTMLImageElement;
        if (!img.getAttribute('src') && img.dataset.src) img.src = img.dataset.src;
        slides.forEach((s, k) => s.classList.toggle('on', k === i));
        if (count) count.textContent = String(i + 1);
      };
      const prev = im.querySelector('.jarrow.prev');
      const next = im.querySelector('.jarrow.next');
      prev?.addEventListener('click', () => show(i - 1));
      next?.addEventListener('click', () => show(i + 1));
    }

    // Click the card image to open the full-size lightbox at the current slide.
    im.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('.jarrow') || (e.target as HTMLElement).closest('.jcount')) return;
      lbOpen(slides.map((s) => (s as HTMLImageElement).src || (s as HTMLImageElement).dataset.src || ''), i);
    });
  });
</script>
