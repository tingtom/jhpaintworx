---
import Base from '../layouts/Base.astro';
import { Truck, Tractor, Sparkles, Hammer, Crosshair, Factory } from 'lucide-astro';
const base = import.meta.env.BASE_URL;
const services = [
  { ic: Truck, t: 'Commercial Vehicle Paintwork', d: 'Fleet cabs, box bodies and HGVs in 2-pack solid colour. Colour-matched to livery, scheduled around your work.' },
  { ic: Tractor, t: 'Plant & Machinery Paintwork', d: 'Excavators, dumpers, trailers and hire fleet — shot-blast prep options and heavy-duty topcoats.' },
  { ic: Sparkles, t: 'Full Resprays', d: 'Glass-out, bare-metal and colour-change resprays with blocking, priming and a deep cut-and-polish.' },
  { ic: Hammer, t: 'Panel Beating & Repairs', d: 'Dents, creases, scratches, bumper scuffs and arch repairs, blended invisibly across panels.' },
  { ic: Crosshair, t: 'Expert Colour Matching', d: 'Spectrometer readings plus spray-out cards in daylight — metallics, pearls and tri-coats that match.' },
  { ic: Factory, t: 'Welding & Restoration', d: 'Sills, arches, floors and classic shells cut out and welded properly before paint.' },
];
---
<Base title="Services">
<section class="block">
  <div class="section-head"><p class="kicker">SERVICES</p><h1>What the booth turns out.</h1><p class="sub">Every job gets the same discipline: strip back what's failed, build it flat, then lay colour and lacquer properly.</p></div>
  <div class="cards wrap">
    {services.map(s => { const Icon = s.ic; return (<div class="scard"><div class="ic"><Icon size={24} /></div><h3>{s.t}</h3><p>{s.d}</p></div>); })}
  </div>
  <div class="cta-band wrap"><div><h2>Not sure what yours needs?</h2><p>Send photos — we'll tell you repair vs respray honestly.</p></div><a class="btn light" href={`${base}contact/`}>Ask for a quote →</a></div>
</section>
</Base>