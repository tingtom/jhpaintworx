---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL;
const services = [
  { ic: '🚚', t: 'Commercial Vehicle Paintwork', d: 'Fleet cabs, box bodies and HGVs in 2-pack solid colour. Colour-matched to livery, scheduled around your work.' },
  { ic: '🚜', t: 'Plant & Machinery Paintwork', d: 'Excavators, dumpers, trailers and hire fleet — shot-blast prep options and heavy-duty topcoats.' },
  { ic: '✨', t: 'Full Resprays', d: 'Glass-out, bare-metal and colour-change resprays with blocking, priming and a deep cut-and-polish.' },
  { ic: '🔨', t: 'Panel Beating & Repairs', d: 'Dents, creases, scratches, bumper scuffs and arch repairs, blended invisibly across panels.' },
  { ic: '🎯', t: 'Expert Colour Matching', d: 'Spectrometer readings plus spray-out cards in daylight — metallics, pearls and tri-coats that match.' },
  { ic: '🏭', t: 'Welding & Restoration', d: 'Sills, arches, floors and classic shells cut out and welded properly before paint.' },
];
---
<Base title="Services">
<section class="block wrap">
<p style="font-weight:800;letter-spacing:.2em;font-size:12px;color:var(--red)">SERVICES</p>
<h1 style="font-size:clamp(30px,5vw,50px);margin-top:8px">What the booth turns out.</h1>
<p style="color:var(--mut);max-width:60ch">Every job gets the same discipline: strip back what’s failed, build it flat, then lay colour and lacquer properly.</p>
<div class="cards">
{services.map(s => (<div class="scard"><div class="ic">{s.ic}</div><h3>{s.t}</h3><p>{s.d}</p></div>))}
</div>
<div class="cta-band"><div><h2>Not sure what yours needs?</h2><p>Send photos — we’ll tell you repair vs respray honestly.</p></div><a class="btn light" href={`${base}contact/`}>Ask for a quote →</a></div>
</section>
</Base>
