---
import Base from '../layouts/Base.astro';
import HeroSlider from '../components/HeroSlider.astro';
import JobCard from '../components/JobCard.astro';
import { getCollection } from 'astro:content';
import { Truck, Tractor, Sparkles, Hammer, Crosshair, Factory } from 'lucide-astro';
const base = import.meta.env.BASE_URL;
const jobs = await getCollection('jobs');
const featured = jobs.filter(j => j.data.featured).slice(0, 6);
const showJobs = featured.length ? featured : jobs.slice(0, 6);
const cats = (await getCollection('categories')).sort((a, b) => a.data.order - b.data.order);
const labels: Record<string,string> = {};
cats.forEach(c => labels[c.slug] = c.data.label);

const ICONS = { truck: Truck, tractor: Tractor, sparkles: Sparkles, hammer: Hammer, crosshair: Crosshair, factory: Factory } as Record<string, any>;
const cmsServices = await getCollection('services');
const services = cmsServices.sort((a, b) => a.data.order - b.data.order);
const aboutData = (await getCollection('about'))[0]?.data;
const aboutImg = aboutData?.image;
---
<Base title="Professional Automotive Spray Painting">
<HeroSlider />

<!-- SERVICES -->
<section class="block">
  <div class="section-head"><p class="kicker">WHAT WE DO</p><h2>Everything short of building the car.</h2><p class="sub">Six core services — every job gets the same prep discipline.</p></div>
  <div class="cards wrap">
    {services.map(s => { const Icon = ICONS[s.data.icon] ?? Sparkles; return (
      <div class="scard">
        <div class="ic"><Icon size={24} /></div>
        <h3>{s.data.title}</h3>
        <p>{s.data.description || s.body}</p>
      </div>
    ); })}
  </div>
</section>

<!-- ABOUT -->
<section class="block" style="padding-block:14px">
  <div class="split wrap">
    <div>
      <div class="section-head" style="padding:0;margin:0 0 8px"><p class="kicker">{aboutData?.kicker || 'MEET THE TEAM'}</p><h2>{aboutData?.title || 'A paint shop that sweats the prep.'}</h2>{aboutData?.sub && <p class="sub">{aboutData.sub}</p>}</div>
      {aboutData?.lead && <p class="lead">{aboutData.lead}</p>}
      <p><a class="btn" href={`${base}about/`}>More about us →</a></p>
    </div>
    <div>
      <img class="frame" src={aboutImg || 'https://images.unsplash.com/photo-1492144534655-ae79c964c9d7?q=80&w=1000&auto=format&fit=crop'} alt="The JH Paintworx team" loading="lazy" />
    </div>
  </div>
</section>

<!-- FEATURED WORK -->
<section class="block">
  <div class="section-head" style="display:flex;align-items:end;justify-content:space-between;gap:12px;flex-wrap:wrap">
    <div><p class="kicker">RECENT JOBS</p><h2>Fresh out of the booth.</h2></div>
    <a class="btn ghost dark" style="margin-bottom:4px" href={`${base}workshop/`}>All work →</a>
  </div>
  <div class="grid wrap">
    {showJobs.map(j => (
      <JobCard job={j} label={labels[j.data.category] ?? j.data.category} />
    ))}
  </div>
</section>
</Base>
