---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
const base = import.meta.env.BASE_URL;
const cats = ['all','car','bike','van','commercial','plant','classic'];
const jobs = await getCollection('jobs');
---
<Base title="Gallery">
<h1>Paint work gallery</h1>
<p>Categorised by car / bike / van / commercial / plant / classic.</p>
<p class="filters">
{cats.map(c => (
<a class={`btn ${c==='all'?'active':''}`} href={c==='all'?`${base}gallery/`:`${base}gallery/${c}/`}>{c}</a>
))}
</p>
<div class="grid">
{jobs.map(j => (
<article class="card">
<img src={j.data.image ?? `https://picsum.photos/seed/${j.slug}/600/400`} alt={j.data.title} loading="lazy" />
<div class="p"><span class="pill">{j.data.category}</span><h3>{j.data.title}</h3><p>{j.data.description}</p></div>
</article>
))}
</div>
{jobs.length===0 && <p>No jobs yet. Add via Admin.</p>}
</Base>
