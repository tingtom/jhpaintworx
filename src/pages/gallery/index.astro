---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
const base = import.meta.env.BASE_URL;
const cats = ['all','car','bike','van','commercial','plant','classic'];
const LABELS: Record<string,string> = { all:'All', car:'Cars', bike:'Bikes', van:'Vans', commercial:'Commercial', plant:'Plant & machinery', classic:'Classics' };
const jobs = await getCollection('jobs');
const img = (j: any) => j.data.image ?? `https://picsum.photos/seed/${j.slug}/800/600`;
---
<Base title="Paint work gallery">
<section class="block wrap">
<p style="font-weight:800;letter-spacing:.2em;font-size:12px;color:var(--red)">GALLERY</p>
<h1 style="font-size:clamp(30px,5vw,50px);margin-top:8px">Paint work, by category.</h1>
<p style="color:var(--mut);max-width:60ch">Tap a category to filter. New jobs appear here automatically when added in Admin.</p>
<div class="pills">
{cats.map(c => (
<a class={c==='all'?'on':''} href={c==='all'?`${base}gallery/`:`${base}gallery/${c}/`}>{LABELS[c]}</a>
))}
</div>
<div class="grid">
{jobs.map(j => (
<article class="job">
<div class="im"><img src={img(j)} alt={j.data.title} loading="lazy" /><span class="cat">{LABELS[j.data.category]}</span></div>
<div class="p"><h3>{j.data.title}</h3><p>{j.data.description ?? ''}</p></div>
</article>
))}
</div>
{jobs.length===0 && <p>No jobs yet — add some via <a href={`${base}admin/`}>Admin</a>.</p>}
</section>
</Base>
