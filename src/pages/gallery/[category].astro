---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
export async function getStaticPaths() {
  return ['car','bike','van','commercial','plant','classic'].map((category) => ({ params: { category } }));
}
const { category } = Astro.params as { category: string };
const base = import.meta.env.BASE_URL;
const cats = ['all','car','bike','van','commercial','plant','classic'];
const LABELS: Record<string,string> = { all:'All', car:'Cars', bike:'Bikes', van:'Vans', commercial:'Commercial', plant:'Plant & machinery', classic:'Classics' };
const TITLES: Record<string,string> = { car:'Cars', bike:'Bikes', van:'Vans', commercial:'Commercial vehicles', plant:'Plant & machinery', classic:'Classics' };
const jobs = await getCollection('jobs');
const list = jobs.filter(j=>j.data.category===category);
const img = (j: any) => j.data.image ?? `https://picsum.photos/seed/${j.slug}/800/600`;
---
<Base title={`${TITLES[category]} gallery`}>
<section class="block">
  <div class="section-head"><p class="kicker">GALLERY / {LABELS[category].toUpperCase()}</p><h1>{TITLES[category]} gallery.</h1></div>
  <div class="pills wrap">
    {cats.map(c => (
      <a class={category===c?'on':''} href={c==='all'?`${base}gallery/`:`${base}gallery/${c}/`}>{LABELS[c]}</a>
    ))}
  </div>
  <div class="grid wrap">
    {list.map(j => (
      <article class="job">
        <div class="im"><img src={img(j)} alt={j.data.title} loading="lazy" /><span class="cat">{LABELS[j.data.category]}</span></div>
        <div class="p"><h3>{j.data.title}</h3><p>{j.data.description ?? ''}</p></div>
      </article>
    ))}
  </div>
  {list.length===0 && <p style="padding:0 20px;color:var(--mut)">No {TITLES[category]} jobs yet — add some via <a href={`${base}admin/`}>Admin</a>.</p>}
  <p style="padding:0 20px;margin-top:24px;color:var(--mut)"><a href={`${base}gallery/`} style="font-weight:700">← All work</a> · <a href={`${base}contact/`} style="font-weight:700">Get a quote for your {TITLES[category]} →</a></p>
</section>
</Base>