---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
export async function getStaticPaths() {
  return ['car','bike','van','commercial','plant','classic'].map((category) => ({ params: { category } }));
}
const { category } = Astro.params as { category: string };
const base = import.meta.env.BASE_URL;
const cats = ['all','car','bike','van','commercial','plant','classic'];
const jobs = await getCollection('jobs');
const list = jobs.filter(j=>j.data.category===category);
const img = (j: any) => j.data.image ?? `https://picsum.photos/seed/${j.slug}/800/600`;
const titles: Record<string,string> = { car:'Cars', bike:'Bikes', van:'Vans', commercial:'Commercial vehicles', plant:'Plant & machinery', classic:'Classics' };
---
<Base title={`${titles[category] ?? category} paint work`}>
<section class="block wrap">
<p style="font-weight:800;letter-spacing:.2em;font-size:12px;color:var(--red)">GALLERY / {category.toUpperCase()}</p>
<h1 style="font-size:clamp(30px,5vw,50px);margin-top:8px">{titles[category] ?? category} paintwork.</h1>
<div class="pills">
{cats.map(c => (
<a class={category===c?'on':''} href={c==='all'?`${base}gallery/`:`${base}gallery/${c}/`}>{c}</a>
))}
</div>
<div class="grid">
{list.map(j => (
<article class="job">
<div class="im"><img src={img(j)} alt={j.data.title} loading="lazy" /><span class="cat">{j.data.category}</span></div>
<div class="p"><h3>{j.data.title}</h3><p>{j.data.description ?? ''}</p></div>
</article>
))}
</div>
{list.length===0 && <p>No {category} jobs yet — add some via <a href={`${base}admin/`}>Admin</a>.</p>}
<p style="margin-top:20px"><a href={`${base}gallery/`}>← All work</a> · <a href={`${base}contact/`}>Get a quote for your {category} →</a></p>
</section>
</Base>
