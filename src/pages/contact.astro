---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { Phone, MapPin } from 'lucide-astro';
const base = import.meta.env.BASE_URL;
const c = (await getCollection('contact'))[0]?.data;
const s = (await getCollection('settings'))[0]?.data;
const phone = s?.phone || '01933 422290';
const tel = `tel:${phone.replace(/[^\+\d]/g, '')}`;
const hours = s?.hours || 'Mon–Fri 07:30–17:30';
const address = s?.address || '';
const email = import.meta.env.PUBLIC_CONTACT_EMAIL ?? s?.email ?? '';
const cats = (await getCollection('categories')).sort((a, b) => a.data.order - b.data.order);
// OpenStreetMap embed with a marker — lat/lon come from the CMS settings.
const hasMap = Number.isFinite(s?.mapLat) && Number.isFinite(s?.mapLon) && !(s?.mapLat === 0 && s?.mapLon === 0);
const mapSrc = hasMap
  ? `https://www.openstreetmap.org/export/embed.html?bbox=${(s.mapLon! - 0.004).toFixed(5)},${(s.mapLat! - 0.0025).toFixed(5)},${(s.mapLon! + 0.004).toFixed(5)},${(s.mapLat! + 0.0025).toFixed(5)}&layer=mapnik&marker=${s.mapLat!.toFixed(5)},${s.mapLon!.toFixed(5)}`
  : '';
---
<Base title="Contact – get a quote">
<section class="block">
  <div class="section-head"><p class="kicker">{c?.kicker ?? 'CONTACT'}</p><h1>{c?.title ?? 'Get a quote.'}</h1><p class="sub">{c?.sub ?? ''}</p></div>
  <div class="split wrap">
    <div>
      <div class="scard"><h3><Phone size={20} /> <a href={tel}>{phone}</a></h3><p>{[hours, c?.phoneNote].filter(Boolean).join(' — ')}</p></div>
      <div class="scard" style="margin-top:14px">
        <h3><MapPin size={20} /> Workshop</h3>
        {address && <p class="addr">{address}</p>}
        {hasMap && (
          <iframe
            class="map"
            title="Workshop location"
            src={mapSrc}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          />
        )}
        {c?.addressNote && <p style="margin-top:12px">{c?.addressNote}</p>}
        <p class="mapcredit">Map data © <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap contributors</a></p>
      </div>
    </div>
    <form class="card" id="qform">
      <label>Your name<input name="name" required placeholder="Jane Bloggs" autocomplete="name" /></label>
      <label>Phone<input name="phone" type="tel" required placeholder="07…" autocomplete="tel" /></label>
      <label>Vehicle / job type<select name="category">{cats.map(cat => <option value={cat.slug}>{cat.data.label}</option>)}</select></label>
      <label>Details<textarea name="message" rows="5" required placeholder="e.g. Focus ST bonnet + bumper stone chips, photos to follow…"></textarea></label>
      <label class="filelabel">Photos of the damage <span class="opt">(optional)</span>
        <input type="file" name="attachment" accept="image/*" multiple />
        <span class="filehint">JPG or PNG, up to 5MB each — photos get you the fastest, most accurate quote.</span>
      </label>
      <p class="filenames" id="filenames"></p>
      <button class="btn" type="submit">Send enquiry →</button>
      <p id="status"></p>
    </form>
  </div>
</section>
<style>
.addr{white-space:pre-line;line-height:1.7}
.map{width:100%;height:240px;border:0;border-radius:12px;margin-top:14px;display:block}
.mapcredit{font-size:11.5px;color:var(--mut);margin:6px 0 0}
.mapcredit a{color:inherit;text-decoration:underline}
.filelabel input[type=file]{margin-top:8px;font-size:14px;width:100%;color:var(--mut)}
.filelabel input[type=file]::file-selector-button{margin-right:10px;padding:9px 14px;border:1px solid var(--navy);border-radius:9px;background:#fff;color:var(--navy);font:inherit;font-size:13.5px;font-weight:700;cursor:pointer;transition:.15s}
.filelabel input[type=file]::file-selector-button:hover{background:var(--navy);color:#fff}
.filelabel .opt{font-weight:500;color:var(--mut);font-size:13px}
.filehint{display:block;font-weight:500;color:var(--mut);font-size:13px;margin-top:5px}
.filenames{font-size:13.5px;color:var(--mut);line-height:1.6;margin:10px 0 0}
</style>
<script define:vars={{ email, phone }}>
const form = document.getElementById('qform');
const status = document.getElementById('status');
const filenames = document.getElementById('filenames');
const MAX = 5 * 1024 * 1024;
form?.querySelector('input[type=file]')?.addEventListener('change', (e) => {
  const files = [...e.target.files];
  filenames.textContent = files.length
    ? files.map(f => `${f.name} (${(f.size / 1048576).toFixed(1)}MB)`).join('\n')
    : '';
});
form?.addEventListener('submit', async (e) => {
  e.preventDefault();
  if (!email) { status.textContent = `Form email not configured yet — please call ${phone}.`; return; }
  const files = [...form.querySelectorAll('input[type=file]')[0].files];
  if (files.some(f => f.size > MAX)) { status.textContent = 'One of those photos is over 5MB — please call ' + phone + ' to send it.'; return; }
  status.textContent = files.length ? 'Sending photos…' : 'Sending…';
  try {
    const r = await fetch(`https://formsubmit.co/ajax/${email}`, {
      method: 'POST',
      headers: { Accept: 'application/json' },
      body: new FormData(form),
    });
    status.textContent = r.ok ? 'Sent — we’ll be in touch shortly.' : `Send failed — please call ${phone}.`;
    if (r.ok) { form.reset(); filenames.textContent = ''; }
  } catch { status.textContent = `Send failed — please call ${phone}.`; }
});
</script>
</Base>
