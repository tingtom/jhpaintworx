---
import Base from '../layouts/Base.astro';
import { Check } from 'lucide-astro';
const base = import.meta.env.BASE_URL;
---
<Base title="About">
<section class="block">
  <div class="section-head"><p class="kicker">ABOUT</p><h1>A paint shop that sweats the prep.</h1><p class="sub">Showroom paintwork for cars, bikes, vans, commercials, plant and classics — prepped properly, painted properly.</p></div>
  <div class="split wrap">
    <div>
      <p class="lead">At JH Paintworx we refresh, restore and reimagine vehicles with flawless finishes and obsessive attention to detail. From commercial fleets and plant-hire machinery to cherished classics, the team is committed to outstanding results every time.</p>
      <p class="mut">No "that'll do". Panels are stripped, filled, primed and flatted until they're right — then colour and lacquer go on in a controlled booth. That's why matches disappear and resprays stay glossy.</p>
      <ul>
        <li><Check size={16} /> Commercial fleets welcome</li>
        <li><Check size={16} /> Insurance-friendly photo quotes</li>
        <li><Check size={16} /> Classics &amp; restorations</li>
        <li><Check size={16} /> Bikes, vans, HGVs, plant</li>
      </ul>
      <p><a class="btn" href={`${base}gallery/`}>See the proof →</a></p>
    </div>
    <div>
      <img class="frame" src="https://images.unsplash.com/photo-1492144534655-ae79c964c9d7?q=80&w=1000&auto=format&fit=crop" alt="Classic car paintwork" loading="lazy" />
    </div>
  </div>
</section>
</Base>