---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { Check } from 'lucide-astro';
const base = import.meta.env.BASE_URL;
const entry = (await getCollection('about'))[0];
const d = entry?.data;
const { Content } = entry ? await entry.render() : { Content: null };
---
<Base title="Meet the team">
<section class="block">
  <div class="split wrap">
    <div>
      <div class="section-head"><p class="kicker">{d?.kicker ?? 'MEET THE TEAM'}</p><h1>{d?.title ?? 'A paint shop that sweats the prep.'}</h1><p class="sub">{d?.sub ?? ''}</p></div>
      {d?.image && <img class="frame" src={d.image} alt={d.title || 'The JH Paintworx team'} loading="eager" decoding="async" />}
      {d?.lead && <p class="lead">{d.lead}</p>}
      {d?.points?.length ? (
        <ul>
          {d.points.map(p => <li><Check size={16} /> {p}</li>)}
        </ul>
      ) : null}
      {Content && <div class="about-body"><Content /></div>}
      <p><a class="btn" href={`${base}workshop/`}>See the proof →</a></p>
    </div>
    <div class="teamcol">
      <p class="kicker">THE TEAM</p>
      {d?.team?.length ? d.team.map(m => (
        <div class="scard tcard">
          {m.photo && <img src={m.photo} alt={m.name} loading="lazy" />}
          <div class="who">
            <h3>{m.name}</h3>
            {m.role && <p class="role">{m.role}</p>}
            {m.blurb && <p>{m.blurb}</p>}
          </div>
        </div>
      )) : <p class="mut">Add team members in Admin to populate this list.</p>}
    </div>
  </div>
</section>
<style>
.about-body p{color:var(--mut);line-height:1.75}
.split .section-head{padding:0;margin:0 0 16px}
.teamcol{display:flex;flex-direction:column;gap:14px}
.teamcol .kicker{margin:0 0 2px}
.teamcol .tcard:first-of-type{margin-top:6px}
.tcard{display:flex;gap:14px;align-items:flex-start;padding:14px}
.tcard img{width:92px;height:92px;object-fit:cover;border-radius:12px;flex:0 0 auto;background:#dde3ea}
.tcard .who{min-width:0}
.tcard h3{font-size:16.5px;margin:0 0 2px}
.tcard .role{color:var(--red);font-size:11.5px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;margin:0 0 6px}
.tcard p{color:var(--mut);font-size:13.5px;line-height:1.55;margin:0}
@media(max-width:800px){.tcard img{width:72px;height:72px}}
</style>
</Base>
