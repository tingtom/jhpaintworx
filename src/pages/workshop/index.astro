---
import Base from '../../layouts/Base.astro';
import JobCard from '../../components/JobCard.astro';
import { getCollection } from 'astro:content';
const base = import.meta.env.BASE_URL;
const cats = (await getCollection('categories')).sort((a, b) => a.data.order - b.data.order);
const labels: Record<string,string> = {};
cats.forEach(c => labels[c.slug] = c.data.label);
const jobs = await getCollection('jobs');
const workshop = (await getCollection('workshop'))[0]?.data ?? { title: 'Workshop', paragraph: '' };
---
<Base title={workshop.title} description="Browse recent resprays and repairs from the JH Paintworx workshop, filtered by vehicle type. New jobs appear here automatically as they are finished.">
<section class="block">
  <div class="section-head"><p class="kicker">WORKSHOP</p><h1>{workshop.title}</h1><p class="sub">{workshop.paragraph || 'Tap a category to filter. New jobs appear here automatically when added in Admin.'}</p></div>
  <div class="pills wrap">
    <a class="on" href={`${base}workshop/`}>All</a>
    {cats.map(c => (
      <a href={`${base}workshop/${c.slug}/`}>{c.data.label}</a>
    ))}
  </div>
  <div class="grid wrap">
    {jobs.map(j => (
      <JobCard job={j} label={labels[j.data.category] ?? j.data.category} />
    ))}
  </div>
  {jobs.length===0 && <p style="padding:0 20px;color:var(--mut)">No jobs yet — add some via <a href={`${base}admin/`}>Admin</a>.</p>}
</section>
</Base>
