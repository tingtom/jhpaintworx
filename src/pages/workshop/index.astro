---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
const base = import.meta.env.BASE_URL;
const cats = ['all','car','bike','van','commercial','plant','classic'];
const LABELS: Record<string,string> = { all:'All', car:'Cars', bike:'Bikes', van:'Vans', commercial:'Commercial', plant:'Plant & machinery', classic:'Classics' };
const jobs = await getCollection('jobs');
const img = (j: any) => j.data.image ?? `https://picsum.photos/seed/${j.slug}/800/600`;
---
<Base title="Gallery">
<section class="block">
  <div class="section-head"><p class="kicker">GALLERY</p><h1>Our work, by category.</h1><p class="sub">Tap a category to filter. New jobs appear here automatically when added in Admin.</p></div>
  <div class="pills wrap">
    {cats.map(c => (
      <a class={c==='all'?'on':''} href={c==='all'?`${base}gallery/`:`${base}gallery/${c}/`}>{LABELS[c]}</a>
    ))}
  </div>
  <div class="grid wrap">
    {jobs.map(j => (
      <article class="job">
        <div class="im"><img src={img(j)} alt={j.data.title} loading="lazy" /><span class="cat">{LABELS[j.data.category]}</span></div>
        <div class="p"><h3>{j.data.title}</h3><p>{j.data.description ?? ''}</p></div>
      </article>
    ))}
  </div>
  {jobs.length===0 && <p style="padding:0 20px;color:var(--mut)">No jobs yet — add some via <a href={`${base}admin/`}>Admin</a>.</p>}
</section>
</Base>