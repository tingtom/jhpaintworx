---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
const base = import.meta.env.BASE_URL;
const cats = (await getCollection('categories')).sort((a, b) => a.data.order - b.data.order);
const labels: Record<string,string> = {};
cats.forEach(c => labels[c.slug] = c.data.label);
const jobs = await getCollection('jobs');
const img = (j: any) => j.data.image ?? `https://picsum.photos/seed/${j.slug}/800/600`;
---
<Base title="Workshop">
<section class="block">
  <div class="section-head"><p class="kicker">WORKSHOP</p><h1>Our work, by category.</h1><p class="sub">Tap a category to filter. New jobs appear here automatically when added in Admin.</p></div>
  <div class="pills wrap">
    <a class="on" href={`${base}workshop/`}>All</a>
    {cats.map(c => (
      <a href={`${base}workshop/${c.slug}/`}>{c.data.label}</a>
    ))}
  </div>
  <div class="grid wrap">
    {jobs.map(j => (
      <article class="job">
        <div class="im"><img src={img(j)} alt={j.data.title} loading="lazy" /><span class="cat">{labels[j.data.category] ?? j.data.category}</span></div>
        <div class="p"><h3>{j.data.title}</h3><p>{j.data.description ?? ''}</p></div>
      </article>
    ))}
  </div>
  {jobs.length===0 && <p style="padding:0 20px;color:var(--mut)">No jobs yet — add some via <a href={`${base}admin/`}>Admin</a>.</p>}
</section>
</Base>
